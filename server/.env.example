# API server configuration. Copy to server/.env and fill in the values.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/juniper

# Set to "false" for a local database without TLS (Neon/Railway/Supabase need TLS).
DATABASE_SSL=true

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# Comma separated list of allowed browser origins for the frontend.
CLIENT_ORIGIN=http://localhost:5173

# SameSite cookie policy. Use "none" in production when the API and the
# frontend are served from different domains, "lax" when they share a domain.
SESSION_SAME_SITE=lax

# Set to "true" to mark the session cookie as Secure (required over HTTPS).
SESSION_SECURE=false

# Port the API listens on.
PORT=4000

NODE_ENV=development
