# Frontend configuration. Copy to .env and adjust.

# Absolute URL of the deployed API. Leave unset in development — the Vite dev
# server proxies /api to http://localhost:4000 so the session cookie stays
# same-origin.
VITE_API_URL=

# Where the Vite dev server proxies /api requests to.
VITE_API_PROXY_TARGET=http://localhost:4000
