{
  "name": "juniper-restaurant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "api": "npm --prefix server run dev",
    "api:start": "npm --prefix server start",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "start": "cd server && npm install --omit=dev && node scripts/migrate.js && node scripts/seed.js && node src/index.js",
    "smoke": "node server/scripts/smoke-test.js",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
